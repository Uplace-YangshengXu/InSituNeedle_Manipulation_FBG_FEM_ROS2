<launch>
    
    <node
    pkg = "sm130_interrogator"
    exec = "talker"
    name = "interrogator_pub"
    output = "screen">
    </node>
    

    <node
    pkg = "curvature_srvcli"
    exec = "server">
    <param name = "interrogator_selection" value = "sm130"/>
    </node>


    <node 
    pkg = "needle_shape"
    exec = "sensor_data_viewer">
    <param name = "channel_selection" value = "1"/>
    </node>
    <node 
    pkg = "needle_shape"
    exec = "sensor_data_viewer">
    <param name = "channel_selection" value = "3"/>
    </node>
    <node 
    pkg = "needle_shape"
    exec = "sensor_data_viewer">
    <param name = "channel_selection" value = "4"/>
    </node>

</launch>

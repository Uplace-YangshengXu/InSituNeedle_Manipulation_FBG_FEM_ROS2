<launch>  
  <node
      pkg = "si155_interrogator"
      exec = "talker"
      name = "interrogator_pub"
      output = "screen">
  </node>
  

  <node
      pkg = "curvature_srvcli"
      exec = "server">
    <param name = "interrogator_selection" value = "si155"/>

  </node>

  

  <node
      pkg = "needle_shape"
      exec = "sensor_data_viewer">
    <param name = "channel_selection" value = "1"/>
  </node>


  <node
      
      pkg = "needle_shape"
      exec = "sensor_data_viewer">
    <param name = "channel_selection" value = "2"/>

  </node>
  <node
      
      pkg = "needle_shape"
      exec = "sensor_data_viewer">
    <param name = "channel_selection" value = "3"/>

  </node>
</launch>

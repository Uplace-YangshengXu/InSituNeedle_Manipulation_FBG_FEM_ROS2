addpath ./Galil_MATLAB_API/;
% old Galil Motor Controller
% address = '192.168.1.201';
% new Galil Motor Controller
address =  '192.168.1.33';
port = 23;
g = galil_connect(address,port); % A connection needs to be made before this line
res = galil_command(g, [char(18), char(22)]);
% disp(res)

% parameter of controller
% axis D: rotery stage                7031.25 unit: 1 degree
% axis B: Y direction of XYZ robot    1000 unit: 1 mm
% axis C: Z direction of XYZ robot    1000 unit: 1 mm
% axis A: X direction of XYZ robot    1000 unit: 1 mm

% for x,y,z,rot axis
galil_command(g, 'PT 1,1,1,1');
galil_command(g, 'KP 323,261,300,58');
galil_command(g, 'KI 9,6,7,2');
galil_command(g, 'KD 2746,2453,2600,433');
galil_command(g, 'AC 9216,9216,9216,9260');
galil_command(g, 'DC 9216,9216,9216,9260');
galil_command(g, 'SP 25000,25000,25000,80000');

flag = true;
promptX = "Input next X displacement (mm) negative-rigt:";
promptY = "Input next Y displacement (mm) negative-up:";
promptZ = "Input next Z displacement (mm) negative-downward:";
promptK = "Input next k(Deg) negative-cw:";


AbsPosX = 0;
AbsPosY = 0;
AbsPosK = 0;
AbsPosZ = 0;

while flag
    usr_input_X = input(promptX, 's');
    input_num_X = str2num(usr_input_X);

    usr_input_Y = input(promptY, 's');
    input_num_Y = str2num(usr_input_Y);

    usr_input_Z = input(promptZ, 's');
    input_num_Z = str2num(usr_input_Z);

    usr_input_K = input(promptK, 's');
    input_num_K = str2num(usr_input_K);

    if isempty(input_num_X) || isempty(input_num_Y) || isempty(input_num_K) || isempty(input_num_Z)
        flag = false;
        disp('Quitting')
        continue;
    else
        AbsPosX = AbsPosX + input_num_X;
        AbsPosY = AbsPosY + input_num_Y;
        AbsPosK = AbsPosK + input_num_K;
        AbsPosZ = AbsPosZ + input_num_Z;
        Input_AbsPos_X = round(AbsPosX*1000);
        Input_AbsPos_Y = round(AbsPosY*1000);
        Input_AbsPos_Z = round(AbsPosZ*1000);
        Input_AbsPos_K = round(AbsPosK*7031.25);
        give_pos=strcat('PA ',num2str(Input_AbsPos_X),',',num2str(Input_AbsPos_Y),',', num2str(Input_AbsPos_Z), ',', num2str(Input_AbsPos_K));
        galil_command(g, give_pos);
        %galil_command(g, 'BG ABCD');
    end
end


%% Homing before quitting
galil_command(g, 'PA 0,0,0,0');
%galil_command(g, 'BG ABCD');

%% Disconnect
galil_disconnect(g)
clear
